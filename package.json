{
  "name": "awg-control",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=2 build",
    "typecheck": "pnpm --filter @awg-control/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @awg-control/contracts build && pnpm -r test",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @awg-control/api --filter @awg-control/web dev",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.35.1"
  }
}
