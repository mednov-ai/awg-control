    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.3",
    "otpauth": "^9.5.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/ssh2": "^1.15.6",
